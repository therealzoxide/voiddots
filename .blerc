# -*- mode: sh; mode: sh-bash -*-

source ~/.scripts/bash/colors

##################
# Basic settings #
##################

bleopt input_encoding=UTF-8
bleopt pager=nvim
bleopt editor=nvim
bleopt default_keymap=vi
bleopt exec_errexit_mark=

#############################
# TRANSIENT PROMPT SETTINGS #
#############################

function hexcolor_bold {
	local hex=${1#\#}
	printf '\e[1;38;2;%d;%d;%dm' \
		"$((16#${hex:0:2}))" \
		"$((16#${hex:2:2}))" \
		"$((16#${hex:4:2}))"
}

local green=$(hexcolor_bold "$green")
local reset=$'\e[0m'

bleopt prompt_ps1_final="${green}>>${reset} "


bleopt prompt_ps1_transient=trim

################
# Vim Settings #
################

function blerc/vim-load-hook {
	((_ble_bash>=40300)) && builtin bind 'set keyseq-timeout 1'

	bleopt prompt_vi_mode_indicator='\e[38;5;109m\q{keymap:vi/mode-indicator}\e[0m'
	bleopt keymap_vi_mode_show=

	bleopt keymap_vi_mode_name_insert=INSERT
	bleopt keymap_vi_mode_name_replace=REPLACE
	bleopt keymap_vi_mode_name_vreplace=VREPLACE
	bleopt keymap_vi_mode_name_visual=VISUSAL
	bleopt keymap_vi_mode_name_select=SELECT
	bleopt keymap_vi_mode_name_linewise=LINE
	bleopt keymap_vi_mode_name_blockwise=BLOCK

	bleopt keymap_vi_mode_string_nmap:=$'\e[1m-- NORMAL --\e[m'
	bleopt keymap_vi_mode_update_prompt=1

	ble-bind -m vi_nmap --cursor 1
	ble-bind -m vi_imap --cursor 5
	ble-bind -m vi_omap --cursor 4
	ble-bind -m vi_xmap --cursor 2
	ble-bind -m vi_smap --cursor 2
	ble-bind -m vi_cmap --cursor 0

}
blehook/eval-after-load keymap_vi blerc/vim-load-hook

##########
# Colors #
##########

ble-face -s region                    fg=$red
ble-face -s region_insert             fg=$cyan
ble-face -s region_match              fg=$yellow
ble-face -s region_target             fg=$magenta
ble-face -s disabled                  fg=$bright_black
ble-face -s overwrite_mode            fg=$yellow

ble-face -s syntax_default            none
ble-face -s syntax_command            fg=$magenta
ble-face -s syntax_quoted             fg=$green
ble-face -s syntax_quotation          fg=$green,bold
ble-face -s syntax_escape             fg=$magenta
ble-face -s syntax_expr               fg=$green
ble-face -s syntax_error              fg=$red
ble-face -s syntax_varname            fg=$yellow
ble-face -s syntax_delimiter          bold
ble-face -s syntax_param_expansion    fg=$yellow
ble-face -s syntax_history_expansion  fg=$yellow
ble-face -s syntax_function_name      fg=$green,bold
ble-face -s syntax_comment            fg=$bright_black
ble-face -s syntax_glob               fg=$magenta,bold
ble-face -s syntax_brace              fg=$cyan,bold
ble-face -s syntax_tilde              fg=$cyan,bold
ble-face -s syntax_document           fg=$yellow
ble-face -s syntax_document_begin     fg=$yellow,bold

ble-face -s command_builtin_dot       fg=$yellow,bold
ble-face -s command_builtin           fg=$yellow
ble-face -s command_alias             fg=$cyan
ble-face -s command_function          fg=$green
ble-face -s command_file              fg=$cyan
ble-face -s command_keyword           fg=$magenta
ble-face -s command_jobs              fg=$yellow,bold
ble-face -s command_directory         fg=$cyan,underline
ble-face -s command_suffix            fg=$yellow
ble-face -s command_suffix_new        fg=$cyan

ble-face -s argument_option           fg=$cyan

ble-face -s filename_directory        fg=$cyan,underline
ble-face -s filename_directory_sticky fg=$yellow,underline
ble-face -s filename_link             fg=$cyan,underline
ble-face -s filename_orphan           fg=$red,underline
ble-face -s filename_setuid           fg=$yellow,underline
ble-face -s filename_setgid           fg=$yellow,underline
ble-face -s filename_executable       fg=$green,underline
ble-face -s filename_other            underline
ble-face -s filename_socket            fg=$cyan,underline
ble-face -s filename_pipe              fg=$magenta,underline
ble-face -s filename_character         fg=$yellow,underline
ble-face -s filename_block             fg=$yellow,underline
ble-face -s filename_warning           fg=$red,underline
ble-face -s filename_url               fg=$cyan,underline
ble-face -s filename_ls_colors         underline

ble-face -s varname_array             fg=$yellow,bold
ble-face -s varname_empty             fg=$cyan
ble-face -s varname_export            fg=$magenta,bold

ble-face -s varname_expr              fg=$green,bold
ble-face -s varname_hash              fg=$cyan,bold
ble-face -s varname_new               fg=$magenta
ble-face -s varname_number            fg=$yellow
ble-face -s varname_readonly          fg=$magenta
ble-face -s varname_transform         fg=$cyan,bold
ble-face -s varname_unset             fg=$yellow

ble-face -s cmdinfo_cd_cdpath         fg=$cyan



ble-face auto_complete="fg=$yellow,underline,italic"
ble-face menu_filter_fixed='bold'
ble-face menu_filter_input="fg=$magenta"

